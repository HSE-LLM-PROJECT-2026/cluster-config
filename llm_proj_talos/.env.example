# Talos management IPs
CP_IP=10.42.0.131
WORKER_1_IP=10.42.0.4
GPU_V100_IP=10.42.0.91
WORKER_2_IP=10.42.0.89
WORKER_3_IP=10.42.0.130

# Node names
CP_HOSTNAME=cp
WORKER_1_HOSTNAME=worker-1
GPU_V100_HOSTNAME=gpu-worker-v100
WORKER_2_HOSTNAME=worker-2
WORKER_3_HOSTNAME=worker-3

# Paths
TALOSCONFIG_PATH=./talosconfig
KUBECONFIG_PATH=./kubeconfig
NODE_CONFIGS_DIR=./node-configs
TALOS_ENDPOINT=

# Flow toggles
APPLY_WORKERS=true
APPLY_WORKER_3=true
WAIT_CP_SECONDS=90
WAIT_API_TIMEOUT_SECONDS=600

# Metrics API (metrics-server)
INSTALL_METRICS_SERVER=true
METRICS_SERVER_MANIFEST_URL=https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml
METRICS_SERVER_KUBELET_INSECURE_TLS=true
METRICS_SERVER_WAIT_SECONDS=180
# Optional: pin metrics-server to a specific node hostname (empty = no pin)
METRICS_SERVER_NODE_HOSTNAME=

# VPN
VPN_SERVER_ENDPOINT=10.42.0.1:50005
VPN_SERVER_PUBLIC_KEY=<SERVER_PUBLIC_KEY>

CP_VPN_IP=10.19.87.10
WORKER_1_VPN_IP=10.19.87.11
GPU_V100_VPN_IP=10.19.87.12
WORKER_2_VPN_IP=10.19.87.14
WORKER_3_VPN_IP=10.19.87.15

CP_WG_PRIVATE_KEY=<CP_PRIVATE_KEY>
WORKER_1_WG_PRIVATE_KEY=<WORKER_1_PRIVATE_KEY>
GPU_V100_WG_PRIVATE_KEY=<GPU_V100_PRIVATE_KEY>
WORKER_2_WG_PRIVATE_KEY=<WORKER_2_PRIVATE_KEY>
WORKER_3_WG_PRIVATE_KEY=<WORKER_3_PRIVATE_KEY>

# GPU
GPU_INSTALLER_IMAGE=factory.talos.dev/metal-installer/<hash>:v1.12.1
