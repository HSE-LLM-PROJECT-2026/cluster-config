KUBECONFIG_PATH=/home/oleg/Documents/hse-llm-project/cluster-config/llm_proj_talos/kubeconfig
TALOSCONFIG_PATH=/home/oleg/Documents/hse-llm-project/cluster-config/llm_proj_talos/talosconfig
STATE_DIR=/home/oleg/Documents/hse-llm-project/cluster-config/node-autorecovery/.state

# Regex for candidate nodes to autoheal.
TARGET_NODE_REGEX='^(worker-|gpu-worker-).*'

# Node must stay NotReady for this time before heal is attempted.
NOT_READY_THRESHOLD_SECONDS=300

# Minimum delay between reboot attempts for the same node.
REBOOT_COOLDOWN_SECONDS=1800

# Drain timeout before fallback cleanup/reboot.
DRAIN_TIMEOUT_SECONDS=120

# Max reboot attempts in one run.
MAX_REBOOTS_PER_RUN=1

# Safety toggles.
SKIP_CONTROL_PLANE=true
DELETE_TERMINATING_PODS=true
AUTO_UNCORDON=true
CHECK_ONLY=false
REQUIRE_STATUS_COLUMN_NOTREADY=true
SKIP_AMBIGUOUS_READY_CONDITIONS=true
MAX_CLUSTER_REBOOTS_PER_WINDOW=2
CLUSTER_REBOOT_WINDOW_SECONDS=3600
MIN_READY_TARGET_NODES=2
API_SERVER_READY_REQUIRED=true
API_SERVER_READY_TIMEOUT_SECONDS=7
MIN_TARGET_NODE_VISIBILITY=2
SKIP_IF_HIGH_NOTREADY_PERCENT=true
HIGH_NOTREADY_PERCENT_THRESHOLD=80
