KUBECONFIG_PATH=/home/oleg/Documents/hse-llm-project/cluster-config/llm_proj_talos/kubeconfig

# Target namespace for workload hardening resources.
TARGET_NAMESPACE=hse-llm-project

# Pod Security Admission labels to apply on TARGET_NAMESPACE.
PSA_ENFORCE=baseline
PSA_AUDIT=restricted
PSA_WARN=restricted

# Feature toggles
APPLY_PRIORITY_CLASSES=true
APPLY_LIMIT_RANGE=true
APPLY_PDB=true
APPLY_ALERTS=true
ENABLE_NODE_AUTORECOVERY=true

# Optional: if monitoring namespace differs.
MONITORING_NAMESPACE=monitoring

# Optional path to node-autorecovery package.
NODE_AUTORECOVERY_DIR=/home/oleg/Documents/hse-llm-project/cluster-config/node-autorecovery

